        <mxCell id="M9xQIHcUOVowaZ2TWMws-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="M9xQIHcUOVowaZ2TWMws-2" target="M9xQIHcUOVowaZ2TWMws-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="M9xQIHcUOVowaZ2TWMws-1" value="&lt;h1&gt;Caso de uso&lt;/h1&gt;&lt;p&gt;RF01 - O sistema deve manter as informações de parceiros que são: respnsáveis por pontos de coleta e responsáveis por empresas coletoras de lixo reciclável.&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;Os responsáveis por pontos de coleta devem informar o tipo de lixo que recebem, o endereço e o horário de funcionámento. Os responsáveis por empresas coletoras de lixo reciclavel devem infromar dia da semana, horário e locais onde recolherão o lxo reciclavel.&lt;/span&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="270" height="230" as="geometry" />
        </mxCell>
        <mxCell id="M9xQIHcUOVowaZ2TWMws-2" value="Responsáveis por &lt;br&gt;empresas coletoras" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="390" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="M9xQIHcUOVowaZ2TWMws-3" value="Responsáveis por &lt;br&gt;pontos de coleta" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="200" y="390" width="30" height="60" as="geometry" />
