        <mxCell id="M9xQIHcUOVowaZ2TWMws-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;endFill=0;" edge="1" parent="1" source="M9xQIHcUOVowaZ2TWMws-4" target="M9xQIHcUOVowaZ2TWMws-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="M9xQIHcUOVowaZ2TWMws-4" value="Parceiros" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;align=center;labelBackgroundColor=default;" vertex="1" parent="1">
