        </mxCell>
        <mxCell id="zH9omssH2ejW9G0I2uLI-3" value="Despesas" style="shape=ext;margin=3;double=1;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="364" y="770" width="100" height="40" as="geometry" />
